# Mustache as a Silica app bundle (silica-os docs/app-bundles.md): silica-packages and
# `cargo xtask os deploy` fill the placeholders and sign it. A system app: from /usr/Applications
# it runs without a sandbox; [permissions] is what a copy elsewhere is given.
# Mustache is the file manager: it needs the whole home folder and the removable
# volumes, and keeps running for the desktop's icons.
format = 1
id = "dev.frascella.Mustache"
name = "Mustache"
generic_name = "File Manager"
comment = "Folders and files"
version = "@VERSION@"
build = @BUILD@
minimum_silica = "0.2.0"
kind = "flutter"
runtime = "dev.silica.Platform//1"
args = ["--size", "1000x700", "--title", "Mustache", "--multi-window"]
categories = ["System", "FileManager", "Utility"]
keywords = ["file", "folder", "documents", "cartelle", "documenti"]

[permissions]
network = false
devices = "gpu"
filesystem = ["home", "/media", "/mnt"]
background = true

[developer]
name = "Silica"
key = "@DEVELOPER_KEY@"
